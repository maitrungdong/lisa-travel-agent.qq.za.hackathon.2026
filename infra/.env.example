# ==== Copy sang infra/.env trên VPS và điền giá trị thật ====

# Domain gốc đã trỏ A record về IP VPS (API sẽ ở api.<DOMAIN>)
DOMAIN=example.com

# Mật khẩu Postgres (tự sinh: openssl rand -hex 16)
POSTGRES_PASSWORD=

# Image API — thay OWNER/REPO bằng repo GitHub của bạn (chữ thường)
API_IMAGE=ghcr.io/OWNER/REPO/api:latest

# Key để agent gọi endpoint ghi dữ liệu của API (tự sinh: openssl rand -hex 16)
AGENT_API_KEY=

# Token bot Zalo — tạo tại https://bot.zaloplatforms.com (dạng id:secret)
ZALO_BOT_TOKEN=

# API key Anthropic cho model của Lisa
ANTHROPIC_API_KEY=
