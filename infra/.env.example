# ============================================================================
#  Copy file này sang .env TRÊN VPS (/opt/zino/.env) rồi điền giá trị thật:
#      cd /opt/zino && cp .env.example .env && vi .env
#
#  ⚠️ .env KHÔNG BAO GIỜ commit vào git và KHÔNG bị rsync ghi đè
#     (scripts/deploy.sh loại trừ nó).
#  ⚠️ Biến nào có `:?` trong docker-compose.yml là BẮT BUỘC — thiếu thì
#     `docker compose up` fail ngay, thay vì chạy sai âm thầm.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Postgres
# ---------------------------------------------------------------------------
# Mật khẩu DB. Tự sinh:  openssl rand -hex 16
# Lưu ý: đổi giá trị này SAU KHI volume pgdata đã được tạo sẽ KHÔNG có tác dụng
# (postgres chỉ đọc lúc init lần đầu) → muốn đổi phải ALTER USER trong DB.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# 2. Image API
# ---------------------------------------------------------------------------
# Do .github/workflows/deploy-api.yml build & push lên GHCR.
# Thay OWNER/REPO bằng repo GitHub (CHỮ THƯỜNG hết — GHCR không nhận chữ hoa).
# Khi demo nên pin theo commit (:sha-<commit>) để rollback được; :latest chỉ để test.
API_IMAGE=ghcr.io/OWNER/REPO/api:latest

# ---------------------------------------------------------------------------
# 3. Domain & CORS
# ---------------------------------------------------------------------------
# ⚠️ Wildcard cert của BTC là *.123c.vn — chỉ phủ ĐÚNG 1 CẤP:
#      dùng được : https://zah-35.123c.vn
#      KHÔNG được: https://api.zah-35.123c.vn  (cert invalid → Zalo từ chối webhook)
# Giá trị này dùng để dựng URL ảnh (https://.../media/<uuid>.jpg cho sendPhoto)
# và link trang recap (https://.../trip/<id>/). KHÔNG có dấu "/" ở cuối.
PUBLIC_BASE_URL=https://zah-35.123c.vn

# Origin được phép gọi /api/ từ trình duyệt, phân tách bằng dấu phẩy.
#   https://h5.zdn.vn   → domain Zalo Mini App khi chạy thật
#   http://localhost:3001 → thêm vào khi dev mini app ở máy (zmp start)
CORS_ORIGINS=https://h5.zdn.vn,https://zah-35.123c.vn

# ---------------------------------------------------------------------------
# 4. Khoá nội bộ
# ---------------------------------------------------------------------------
# Khoá để worker/agent gọi các endpoint ghi dữ liệu của API (AgentKeyGuard).
# Tự sinh:  openssl rand -hex 16
AGENT_API_KEY=

# ---------------------------------------------------------------------------
# 5. Zalo Bot
# ---------------------------------------------------------------------------
# Token bot, dạng "<botId>:<secret>". Lấy tại https://bot.zaloplatforms.com
#   → chọn bot → mục API Token → Copy.
# Token nằm THẲNG TRONG URL: https://bot-api.zaloplatforms.com/bot<TOKEN>/<method>
# → coi như mật khẩu, lộ là mất bot.
ZALO_BOT_TOKEN=

# Secret của webhook. BẠN tự sinh rồi khai báo cho Zalo lúc gọi setWebhook:
#   openssl rand -hex 16
# Zalo gửi lại đúng chuỗi này ở header `X-Bot-Api-Secret-Token` trong mỗi
# request webhook → API so sánh constant-time để chặn request giả mạo.
# Đổi giá trị ở đây thì PHẢI gọi setWebhook lại (xem docs/setup/07-deploy-1-ngay.md).
ZALO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 6. Claude
# ---------------------------------------------------------------------------
# API key Anthropic (sk-ant-...). Lấy tại https://console.anthropic.com → API Keys.
# VPS đã test egress tới api.anthropic.com OK (~36ms).
ANTHROPIC_API_KEY=

# Model cho tab "Hỏi Zino" trong Mini App (chat đồng bộ, người dùng ngồi chờ).
#   claude-haiku-4-5-20251001  — mặc định, ~1-2s/lượt
#   claude-sonnet-5            — trả lời tự nhiên hơn, ~3-4s/lượt
# Để TRỐNG cũng an toàn: code dùng envStr() nên chuỗi rỗng rơi về mặc định.
# (Trước đây dùng `??` — biến rỗng làm tên model thành "" và MỌI câu hỏi rơi
#  về câu tất định trong im lặng. Đừng đổi lại `??`.)
ZINO_CHAT_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# 6b. Partner Network — uỷ quyền OA đối tác (tuỳ chọn)
# ---------------------------------------------------------------------------
# Cho phép OA du lịch bấm "Cho phép" để gia nhập mạng lưới Zino. Sau đó tin
# khách nhắn cho OA đó về thẳng webhook của mình và agent trả lời thay merchant.
# Xem docs/PARTNER-NETWORK.md. Bỏ trống = tắt tính năng, mọi thứ khác vẫn chạy.
#
# Lấy tại developers.zalo.me → ứng dụng của bạn → Thông tin ứng dụng.
ZALO_APP_ID=
ZALO_APP_SECRET=
#
# Khai báo trên developers.zalo.me → Official Account → Webhook:
#   URL      https://<PUBLIC_BASE_URL>/oa/webhook
#   Sự kiện  user_send_text
# OA Secret Key dùng để verify chữ ký X-ZEvent-Signature.
# ⚠️ Bỏ trống = KHÔNG kiểm tra chữ ký (chỉ chấp nhận khi dev).
ZALO_OA_SECRET=
#
# Redirect URI phải khai ĐÚNG chuỗi này trong app Zalo, sai 1 ký tự là Zalo từ chối:
#   https://<PUBLIC_BASE_URL>/oa/callback

# ---------------------------------------------------------------------------
# 7. Tùy chọn — hầu như không cần đụng
# ---------------------------------------------------------------------------
# Thư mục TRÊN HOST được mount vào container api và được nginx serve trực tiếp.
# Chỉ đổi khi deploy ra ngoài /opt/zino — khi đó phải sửa cả infra/nginx/zino.conf.
# MEDIA_HOST_DIR=/opt/zino/media
# RECAP_HOST_DIR=/opt/zino/recap

# ── Pipeline 4 agent (A Trip Alignment → B Offer Scout → C Composer → D Packager) ──
# Tắt (0) = hệ thống chạy y hệt trước khi có pipeline. Đây là đường lui nhanh
# nhất nếu Managed Agents trục trặc: đổi biến này rồi `docker compose up -d api`.
# Bật cũng đồng thời gỡ tool `request_deep_plan` để model không có hai đường
# lên kế hoạch.
ZINO_PIPELINE_ENABLED=0

# API key RIÊNG cho Managed Agents. Cần khi 4 agent nằm ở workspace khác với
# key mà AgentService đang dùng — key Anthropic gắn theo workspace, không nhìn
# thấy tài nguyên của workspace khác. Cùng workspace thì để trống.
ZINO_AGENT_API_KEY=

# agent_id của 4 agent team dựng trên Claude Console — lấy bằng `ant beta:agents list`
ZINO_AGENT_A_ID=agent_01TBZcBWYjQQvbUmmgHCm55i   # Trip Alignment
ZINO_AGENT_B_ID=agent_01MxRs3gzVcUztzi9T9RY2mM   # v2_offer_scout (có MCP booking)
ZINO_AGENT_C_ID=agent_01RxtjwNTz566xXYUkAitL7E   # Itinerary Composer
ZINO_AGENT_D_ID=agent_016LbnSe4VpuveKisxwNZSB4   # Action Packager
# ⚠ environment cũng thuộc workspace — phải lấy/tạo trong ĐÚNG workspace của agent.
# ⚠ Offer Scout dùng MCP server của Booking.com. Environment mặc định là
#   `limited` với allow_mcp_servers=false → session create trả 400. Phải tạo
#   environment cho phép host đó:
#     ant beta:environments create <<'YAML'
#     name: zino-prod
#     config:
#       type: cloud
#       networking:
#         type: limited
#         allowed_hosts: [demandapi-mcp.booking.com]
#         allow_mcp_servers: true
#         allow_package_managers: true
#     YAML
ZINO_AGENT_ENV_ID=

# B là stage DUY NHẤT có tool (web search) → phải dựng sandbox và chạy nhiều
# vòng, nên timeout rộng hơn hẳn ba stage kia.
# ZINO_STAGE_A_TIMEOUT_MS=30000
# ZINO_STAGE_B_TIMEOUT_MS=120000
# ZINO_STAGE_C_TIMEOUT_MS=45000
# ZINO_STAGE_D_TIMEOUT_MS=30000

# Run bị bỏ quên (owner không bao giờ chọn) sẽ hết hạn sau ngần này, để nhóm
# mở được kế hoạch mới. Mặc định 24h.
# ZINO_PIPELINE_TTL_MS=86400000

# Số phương án C dựng ra
# ZINO_N_VARIANTS=3

# An toàn tiền bạc cho D. dry_run=1 (mặc định) → D chỉ ĐÓNG GÓI hành động,
# không bao giờ tự thực thi. Đặt 0 là mở khoá — đừng làm thế trong hackathon.
# ZINO_POLICY_DRY_RUN=1
# ZINO_PER_ACTION_CAP=
# ZINO_ALLOWED_ACTIONS=send_inquiry,prefill_booking,share_for_approval,add_to_calendar

# ── Agent System v7.1 — ba agent Intake → Brain → Finalizer ───────────────────
# Bật cái này thì pipeline 4-agent (ZINO_PIPELINE_ENABLED) bị bỏ qua.
# Tắt cả hai = bot chạy y như trước khi có multi-agent.
ZINO_V7_ENABLED=0

# agent_id trên Claude Console. LƯU Ý: khác 4 id của kiến trúc v2 ở trên.
ZINO_AGENT_INTAKE_ID=
ZINO_AGENT_BRAIN_ID=
ZINO_AGENT_FINALIZER_ID=

# Brain là opus-5 effort high, ngân sách tới 4 search + 4 fetch + 2 bash, lại
# phải sinh cả draft lẫn evidence lẫn quality. Đo thật cho v2_offer_scout
# (sonnet-5, nhẹ hơn nhiều) đã là 87s — trong đó 77s CHỈ để sinh JSON.
# ZINO_INTAKE_TIMEOUT_MS=45000
# ZINO_BRAIN_TIMEOUT_MS=300000
# ZINO_FINALIZER_TIMEOUT_MS=90000

# ---------------------------------------------------------------------------
# 8. Link Mini App
# ---------------------------------------------------------------------------
# Địa chỉ công khai của Mini App, dùng để Zino gửi link vào nhóm Zalo.
# Lấy từ dòng "View app at:" khi chạy `zmp deploy`, dạng:
#   https://zalo.me/s/<APP_ID>/
#
# ⚠ THIẾU BIẾN NÀY KHÔNG GÂY LỖI — nó chỉ lặng lẽ rơi về link trang tổng kết
#   HTML. Đó chính là chuyện đã xảy ra: biến có trong docker-compose nhưng
#   không có ở đây, nên suốt thời gian qua không link nào mở được Mini App.
#
# Code tự nối `#/?trip=<id>` phía sau, ĐỪNG tự thêm vào đây.
ZINO_MINIAPP_URL=
