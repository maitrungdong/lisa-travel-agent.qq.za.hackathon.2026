# Hostname public của API — mini app gọi vào đây.
# Mặc định api.{$DOMAIN}; set API_HOST trong .env để ghi đè (cần khi dùng wildcard
# cert chỉ phủ 1 cấp, vd *.123c.vn chỉ hợp lệ cho <team>.123c.vn, KHÔNG cho api.<team>.123c.vn).
{$API_HOST} {
	# CADDY_TLS trống  → Caddy tự xin Let's Encrypt (cần port 80 vào được từ internet).
	# Có giá trị       → dùng cert sẵn có, vd: CADDY_TLS=tls /certs/cert.pem /certs/key.pem
	{$CADDY_TLS}

	reverse_proxy api:3000
}
