# ---------------------------------------------------------------------------
# Zalo Mini App — biến môi trường
# Copy sang .env.local (dev) — KHÔNG commit .env / .env.local
# ---------------------------------------------------------------------------

# --- Credential deploy (chỉ dùng ở local & CI, KHÔNG vào bundle) ------------
# zmp-cli đọc 2 key này từ .env ở thư mục gốc project.
# Lấy tại: developers.zalo.me > Công cụ > API Explorer > Lấy Access Token
APP_ID=
ZMP_TOKEN=

# --- Biến build-time cho Vite ----------------------------------------------
# CẢNH BÁO: mọi biến VITE_* đều bị inline vào bundle JS và AI TẢI APP CŨNG ĐỌC
# ĐƯỢC. Tuyệt đối không đặt secret (API key, DB password, ZaloPay key1/key2) ở
# đây. Secret phải nằm ở backend.
VITE_APP_ENV=development
VITE_API_BASE_URL=https://api-dev.example.com
VITE_ZALO_OA_ID=
VITE_SENTRY_DSN=
VITE_ENABLE_MOCK=true
