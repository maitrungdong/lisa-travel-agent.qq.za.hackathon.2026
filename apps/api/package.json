{
  "name": "api",
  "private": true,
  "scripts": {
    "start:dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed:partners": "node -r ts-node/register/transpile-only src/db/seed-partners.ts",
    "seed:demo": "node -r ts-node/register/transpile-only src/db/seed-demo-trip.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.0",
    "@anthropic-ai/sdk": "^0.71.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
