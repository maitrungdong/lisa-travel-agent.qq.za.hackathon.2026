# Backend API — copy sang .env khi chạy local
PORT=3000
DATABASE_URL=postgres://lisa:lisa@localhost:5432/lisa
# CORS: origin của mini app khi dev (zmp dev server) — prod là https://h5.zdn.vn
CORS_ORIGINS=http://localhost:5173,https://h5.zdn.vn
# Key để OpenClaw agent gọi các endpoint ghi dữ liệu (header x-api-key)
AGENT_API_KEY=change-me
